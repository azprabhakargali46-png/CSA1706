
% BEST FIRST SEARCH ALGORITHM

% Graph connections

edge(a, b).
edge(a, c).
edge(b, d).
edge(b, e).
edge(c, f).
edge(c, g).
edge(d, h).
edge(e, h).
edge(f, h).
edge(g, h).

% Heuristic values

heuristic(a, 7).
heuristic(b, 6).
heuristic(c, 4).
heuristic(d, 5).
heuristic(e, 3).
heuristic(f, 2).
heuristic(g, 6).
heuristic(h, 0).

% Best First Search

best_first(Start, Goal) :-
    search([Start], Goal, [Start]).

search([Goal|_], Goal, Path) :-
    reverse(Path, FinalPath),
    write('Path: '),
    write(FinalPath),
    nl.

search([Current|Rest], Goal, Visited) :-
    findall(H-Next,
        (edge(Current, Next),
         \+ member(Next, Visited),
         heuristic(Next, H)),
        Children),
    keysort(Children, Sorted),
    extract_nodes(Sorted, Nodes),
    append(Nodes, Rest, NewQueue),
    (NewQueue = [] ->
        write('Goal not found.')
    ;
        NewVisited = Visited,
        search(NewQueue, Goal, NewVisited)
    ).

extract_nodes([], []).

extract_nodes([_-Node|Rest], [Node|Nodes]) :-
    extract_nodes(Rest, Nodes).
